# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_CHAT_IDS=123456789,987654321
USER_NAME=Usuario

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Wake-on-LAN Settings
WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
WOL_BROADCAST_IP=192.168.1.255
WOL_TARGET_IP=192.168.1.100

# Obsidian Vault Path inside container
VAULT_PATH=/vault

# Database Configuration (SQLite)
DATABASE_URL=sqlite+aiosqlite:///data/lilo.db

# Timezone (e.g. America/Santiago, Europe/Madrid, America/New_York)
TIMEZONE=America/Santiago

# Host paths for Docker volumes (optional overrides)
HOST_VAULT_PATH=./vault
HOST_BACKUPS_PATH=./backups
